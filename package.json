{
  "name": "hirameki-relay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "infra"
  ],
  "scripts": {
    "dev:web": "npm run dev -w @hirameki-relay/web",
    "dev:api": "npm run dev -w @hirameki-relay/api",
    "docs:api": "npm run docs:api -w @hirameki-relay/api",
    "docs:api:check": "npm run docs:api:check -w @hirameki-relay/api",
    "docs:infra": "npm run docs:infra -w @hirameki-relay/infra",
    "docs:infra:check": "npm run docs:infra:check -w @hirameki-relay/infra",
    "docs:check": "npm run docs:api:check && npm run docs:infra:check",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "cdk:synth": "npm run synth -w @hirameki-relay/infra"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.24.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
