{
  "openapi": "3.1.0",
  "info": {
    "title": "Hirameki Relay API",
    "version": "0.1.0",
    "description": "ひらめきリレー MVP のルーム作成、参加、進行操作を提供する Hono API。"
  },
  "servers": [
    {
      "url": "/api",
      "description": "CloudFront / local proxy under /api"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "ヘルスチェック",
        "responses": {
          "200": {
            "description": "API が応答可能",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/openapi.json": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "OpenAPI JSON",
        "description": "runtime が公開する OpenAPI document。生成 docs の source of truth。",
        "responses": {
          "200": {
            "description": "OpenAPI document",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/rooms": {
      "post": {
        "tags": [
          "rooms"
        ],
        "summary": "ルームを作成",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JoinRoomRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "作成されたルームとホストセッション",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            }
          },
          "400": {
            "description": "入力値が不正",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          },
          "401": {
            "description": "参加者トークンが不正または不足",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "権限不足",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "ルームが存在しない",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "ルームまたはラウンド状態が操作条件を満たさない",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          },
          "500": {
            "description": "予期しないサーバーエラー",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/rooms/{roomId}/join": {
      "post": {
        "tags": [
          "rooms"
        ],
        "summary": "ルームに参加",
