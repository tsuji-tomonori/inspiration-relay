{
  "name": "@hirameki-relay/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/app.js",
  "types": "./dist/app.d.ts",
  "scripts": {
    "dev": "node --import tsx src/dev.ts",
    "build": "tsc -p tsconfig.json && esbuild src/handler.ts src/ws-handler.ts --bundle --platform=node --target=node22 --format=cjs --outdir=dist --external:@aws-sdk/*",
    "docs:api": "tsx src/generate-api-docs.ts",
    "docs:api:check": "tsx src/generate-api-docs.ts --check",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.8",
    "@hirameki-relay/game-core": "0.1.0",
    "@hirameki-relay/shared": "0.1.0",
    "hono": "^4.6.12"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "vitest": "^2.1.8"
  }
}
